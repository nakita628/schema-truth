{
  "title": "Api",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": { "type": "string" },
    "spec": {
      "type": "object",
      "properties": {
        "tags": { "type": "array", "items": { "$ref": "#/properties/spec/definitions/Tag" } },
        "root": { "$ref": "#/properties/spec/definitions/Node" }
      },
      "definitions": {
        "Tag": { "type": "object", "properties": { "label": { "type": "string" } } },
        "Node": {
          "type": "object",
          "properties": {
            "children": { "type": "array", "items": { "$ref": "#/properties/spec/definitions/Node" } }
          }
        }
      }
    }
  }
}
