{
  "title": "Settings",
  "type": "object",
  "properties": {
    "precision": { "default": "7", "allOf": [{ "$ref": "#/$defs/Precision" }] },
    "mode": { "default": "'strict'", "allOf": [{ "$ref": "#/$defs/Mode" }] },
    "fallbackMode": { "default": "coerce", "allOf": [{ "$ref": "#/$defs/Mode" }] },
    "ratio": { "type": "number", "default": "0.5" },
    "count": { "type": "integer", "nullable": true, "default": "null" },
    "attachments": {
      "type": "string",
      "oneOf": [{ "type": "string", "enum": ["cover"] }, { "type": "boolean" }],
      "default": false
    }
  },
  "$defs": {
    "Precision": { "type": "number" },
    "Mode": { "type": "string", "enum": ["coerce", "ignore_malformed", "strict"] }
  }
}
