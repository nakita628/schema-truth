{
  // `vp fmt` (oxfmt) owns Markdown whitespace — it re-pads tables, which is what keeps
  // MD060 satisfied — but it never re-wraps prose. Wrapping therefore stays a human
  // judgement and MD013 is off; structure is this linter's job.
  "globs": ["**/*.md", "**/*.mdc"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    // A symlink to packages/schema-truth/README.md, which is linted directly.
    "README.md",
  ],
  "config": {
    "default": true,
    "MD013": false,
  },
}
